# Browser-visible local origins
VITE_API_BASE_URL=http://127.0.0.1:3000
PREVIEW_BASE_URL=http://127.0.0.1:4174
EDITOR_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# API service
API_HOST=127.0.0.1
API_PORT=3000
COOKIE_SECURE=false
DATABASE_URL=postgres://wikione:wikione@127.0.0.1:5432/wikione
MEDIAWIKI_USER_AGENT=WikiOne/0.1 (https://github.com/feconi1024/wikione; replace-with-contact)
PREVIEW_TTL_MILLISECONDS=120000

# Isolated preview service and ephemeral bundle store
PREVIEW_HOST=127.0.0.1
PREVIEW_PORT=4174
REDIS_URL=redis://127.0.0.1:6379

# Generate independent 32-byte base64 secrets outside source control for every
# non-local deployment. These local examples are intentionally not secrets.
SESSION_KEY_ID=local-development
SESSION_ENCRYPTION_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SESSION_LOOKUP_HMAC_KEY_BASE64=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=

# Wikimedia OAuth variables intentionally do not exist. First-party WikiOne
# accounts work independently; Wikimedia connection and publishing remain
# unavailable until public consumer registration is approved.
